# Copia este fichero a .env y rellena tus credenciales
# cp .env.example .env

# Conexión a Turso (libSQL)
DATABASE_URL = "libsql://tu-base-de-datos.tu-region.turso.io"
AUTH_TOKEN = "tu-token-de-turso"

# API key de Resend para el envío de emails
RESEND_API_KEY = "re_tu_api_key"

# Secreto para firmar la cookie de sesión del panel de administración
ADMIN_SECRET = "un-secreto-largo-y-aleatorio"

# Secreto para firmar los enlaces de cancelación de reserva
CANCEL_SECRET = "otro-secreto-largo-y-aleatorio"

# URL pública del sitio (ej: http://localhost:4321)
PUBLIC_SITE_URL = "http://localhost:4321"
