---
import { Image } from "astro:assets";
import AllergenCard from "@components/AllergenCard.astro";
import type { Dish } from "@db/schema";
import { getDishImage } from "@utils/images";

interface AllergenWithOption {
  id: number;
  name: string;
  without_option?: number;
}

export interface Props {
  dish: Dish;
  allergens: AllergenWithOption[];
  category: string;
  isEager?: boolean;
}

const { dish, allergens, category, isEager = false } = Astro.props;
const image = getDishImage(dish.image ?? "");
const withoutOptions = allergens.filter((a) => a.without_option === 1);
---

<div
  class="bg-card flex flex-col gap-1 w-full h-full transition-all duration-300 ease-out data-hidden:opacity-0 data-hidden:scale-95 data-hidden:hidden"
  data-category={category}
  data-allergens={allergens.map((a) => a.name).join(",")}
  data-allergens-without={withoutOptions.map((a) => a.name).join(",")}
>
  {
    image && (
      <Image
        class="w-full rounded object-cover"
        alt={dish.name}
        width={300}
        height={200}
        src={image}
        loading={isEager ? "eager" : "lazy"}
        fetchpriority={isEager ? "high" : "auto"}
      />
    )
  }
  <div class="flex flex-row gap-1 justify-between">
    <h3 class="text-primary font-serif text-xl px-4">{dish.name}</h3>
    <div class="flex flex-col px-3">
      <p class="text-accent-light text-end text-sm">
        {dish.price.toFixed(2)}€
      </p>
    </div>
  </div>
  {
    dish.description && (
      <p class="text-accent-light px-4 pb-2 text-sm">{dish.description}</p>
    )
  }
  {
    allergens.length > 0 && (
      <div class="flex flex-col gap-2 px-4 pb-3">
        <p class="text-primary text-sm font-bold">Alérgenos:</p>
        <div class="flex flex-row gap-2 flex-wrap" role="list" aria-label="Alérgenos del plato">
          {allergens.map((a) => (
            <AllergenCard name={a.name} />
          ))}
        </div>
      </div>
    )
  }
  {
    withoutOptions.length > 0 && (
      <div class="flex flex-col gap-2 px-4 pb-3">
        <p class="text-sm text-accent-light font-bold">Opciones sin:</p>
        <div class="flex flex-row gap-2 flex-wrap" role="list" aria-label="Alérgenos disponibles sin">
          {withoutOptions.map((a) => (
            <div class="border border-accent-light/50 rounded-md justify-center items-center">
              <span class="text-accent-light px-1.5 py-0.5 text-xs text-center">
                Sin {a.name}
              </span>
            </div>
          ))}
        </div>
      </div>
    )
  }
  <div class="flex flex-row p-4 gap-2 mt-auto">
    <a
      href={`/admin/edit/${dish.id}`}
      class="text-primary hover:text-accent hover:scale-110 transition-all duration-300"
      aria-label={`Editar ${dish.name}`}
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" class="icon icon-tabler icons-tabler-outline icon-tabler-pencil" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="none" d="M0 0h24v24H0z"/><path d="M4 20h4L18.5 9.5a2.828 2.828 0 1 0-4-4L4 16zm9.5-13.5 4 4"/></svg>
      <span class="sr-only">Editar {dish.name}</span>
    </a>
    <form
      method="post"
      action="/api/dishes/delete"
      onsubmit="return confirm('¿Seguro que quieres borrar este plato?')"
    >
      <input type="hidden" name="dish_id" value={dish.id} />
      <button
        class="text-primary hover:cursor-pointer hover:text-accent hover:scale-110 transition-all duration-300"
        aria-label={`Eliminar ${dish.name}`}
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" class="icon icon-tabler icons-tabler-outline icon-tabler-trash" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="none" d="M0 0h24v24H0z"/><path d="M4 7h16m-10 4v6m4-6v6M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2l1-12M9 7V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v3"/></svg>
        <span class="sr-only">Eliminar {dish.name}</span>
      </button>
    </form>
  </div>
</div>
