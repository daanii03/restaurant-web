---
import hoursConfig from "@data/hours.json";
import { restaurant } from "@data/restaurant";

type HoursData = Record<string, { closed?: boolean; slots?: string[][] }>;
const hours = hoursConfig as HoursData;

const DAY_NAMES: Record<string, string> = {
  "0": "Domingo",
  "1": "Lunes",
  "2": "Martes",
  "3": "Miércoles",
  "4": "Jueves",
  "5": "Viernes",
  "6": "Sábado",
};

function formatHours(h: HoursData[string]): string {
  if (h?.closed || !h?.slots || h.slots.length === 0) return "Cerrado";
  return h.slots.map((s) => `${s[0].replace(/^0/, "")}-${s[1].replace(/^0/, "")}`).join(" | ");
}
---

<footer class="grid grid-cols-1 sm:grid-cols-3 gap-6 bg-elevated p-6 text-primary" role="contentinfo">
  <div>
    <h2 class="font-serif text-lg mb-2">{restaurant.name}</h2>
    <p class="text-sm text-primary/60">{restaurant.tagline}</p>
  </div>
  <div>
    <h3 class="font-bold text-sm mb-2">Contacto</h3>
    <p class="text-sm text-primary/60">{restaurant.address.street}</p>
    <p class="text-sm text-primary/60">{restaurant.address.postalCode} {restaurant.address.locality}, {restaurant.address.region}</p>
    <a href={`tel:${restaurant.phone.tel}`} class="text-sm text-accent-light hover:underline">{restaurant.phone.display}</a>
  </div>
  <div>
    <h3 class="font-bold text-sm mb-2">Horario</h3>
    {
      Object.entries(DAY_NAMES).map(([day, label]) => (
        <div class="flex flex-row justify-between gap-2 text-sm text-primary/60">
          <span>{label}:</span>
          <span class="text-right">{formatHours(hours[day])}</span>
        </div>
      ))
    }
  </div>
  <div class="sm:col-span-3 text-center text-xs text-primary/40 pt-4 border-t border-muted/20">
    &copy; {new Date().getFullYear()} {restaurant.name}. Todos los derechos reservados.
  </div>
</footer>
