---
export interface Props {
  title?: string;
  description?: string;
  justify?: "start" | "center";
}

const { title = "Tu Restaurante", description = "Restaurante en Tu Ciudad, Tu Región. Especialistas en carnes maduradas y hamburguesas gourmet. Descubre nuestra carta y reserva tu mesa.", justify = "center" } = Astro.props;

import "@fontsource/eb-garamond/400.css";
import "@fontsource/eb-garamond/700.css";
import "@fontsource/hanken-grotesk/400.css";
import "@fontsource/hanken-grotesk/700.css";
import "@styles/global.css";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import MobileNav from "@components/MobileNav.astro";

import hoursConfig from "@data/hours.json";
type HoursData = Record<string, { closed?: boolean; slots?: string[][] }>;
const hoursData = hoursConfig as HoursData;

const DAY_NAMES_EN: Record<string, string[]> = {
  "0": ["Sunday"],
  "1": ["Monday"],
  "2": ["Tuesday"],
  "3": ["Wednesday"],
  "4": ["Thursday"],
  "5": ["Friday"],
  "6": ["Saturday"],
};

function toSeoHours() {
  const specs: { "@type": string; dayOfWeek: string[]; opens: string; closes: string }[] = [];
  for (const [day, cfg] of Object.entries(hoursData)) {
    if (cfg.closed || !cfg.slots) continue;
    const dayNames = DAY_NAMES_EN[day];
    if (!dayNames) continue;
    for (const [open, close] of cfg.slots) {
      specs.push({
        "@type": "OpeningHoursSpecification",
        dayOfWeek: dayNames,
        opens: open,
        closes: close,
      });
    }
  }
  return specs;
}

const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? "http://localhost:4321";
const fullTitle = title === "Tu Restaurante" ? title : `${title} | Tu Restaurante`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="Tu Restaurante, restaurante Tu Ciudad, bar Tu Ciudad, Tu Región, carnes maduradas, hamburguesas gourmet, cocina castellana, restaurante Tu Región" />
    <link rel="canonical" href={siteUrl + Astro.url.pathname} />

    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl + Astro.url.pathname} />
    <meta property="og:locale" content="es_ES" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Restaurant",
      name: "Tu Restaurante",
      description: "Restaurante en Tu Ciudad especializado en carnes maduradas y hamburguesas gourmet.",
      url: siteUrl,
      telephone: "+34600000000",
      servesCuisine: ["Española", "Castellana", "Hamburguesas gourmet", "Carnes maduradas"],
      priceRange: "€€",
      address: {
        "@type": "PostalAddress",
        streetAddress: "Calle de Tu Restaurante, 1",
        addressLocality: "Tu Ciudad",
        addressRegion: "Tu Región",
        postalCode: "00000",
        addressCountry: "ES",
      },
      openingHoursSpecification: toSeoHours(),
    })} />
  </head>
  <body class="font-sans flex flex-col min-h-screen bg-base">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:bg-accent focus:text-black focus:px-4 focus:py-2 focus:rounded-sm">
      Saltar al contenido principal
    </a>
    <Header />
    <main id="main-content" class={`flex-1 flex flex-col ${justify === "start" ? "justify-start" : "justify-center"} items-center`} role="main">
      <slot />
    </main>
    <Footer />
    <MobileNav />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
  }
</style>
