---
export interface Props {
  title?: string;
  pageTitle: string
}

const { title,pageTitle } = Astro.props;

import "@fontsource/eb-garamond/400.css";
import "@fontsource/eb-garamond/700.css";
import "@fontsource/hanken-grotesk/400.css";
import "@fontsource/hanken-grotesk/700.css";
import "@styles/global.css";
import { restaurant } from "@data/restaurant";

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const default_style =
  "text-primary hover:text-accent hover:scale-105 transition duration-300";
const is_active = "text-accent";
const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? "http://localhost:4321";
const pageTitleFormatted = title ?? `Gestión - ${restaurant.name}`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitleFormatted}</title>
    <meta name="description" content={`Panel de gestión de ${restaurant.name}, restaurante en ${restaurant.address.locality}.`} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href={siteUrl + Astro.url.pathname} />
  </head>
  <body class="font-sans min-h-screen bg-elevated md:flex md:flex-row md:h-screen md:overflow-hidden">
    <a href="#admin-main" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:bg-accent focus:text-black focus:px-4 focus:py-2 focus:rounded-sm">
      Saltar al contenido principal
    </a>

    <div
      id="backdrop"
      class="fixed inset-0 bg-black/60 z-30 hidden"
      data-toggle-sidebar
      aria-hidden="true"
    ></div>

    <aside
      id="sidebar"
      class="bg-base w-64 p-4 flex flex-col fixed md:static inset-y-0 left-0 z-40 -translate-x-full md:translate-x-0 transition-transform duration-300 shrink-0"
      aria-label="Navegación del panel"
    >
      <div class="flex items-center justify-between md:justify-start">
        <h1 class="text-primary font-serif text-4xl">{restaurant.name}</h1>
        <button class="md:hidden text-primary text-2xl" data-toggle-sidebar aria-label="Cerrar menú lateral">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="18" y1="6" x2="6" y2="18" />
            <line x1="6" y1="6" x2="18" y2="18" />
          </svg>
        </button>
      </div>
      <nav class="pt-10 md:pt-20 flex flex-col gap-4" aria-label="Secciones de administración">
        <a
          href="/admin/dashboard"
          class={pathname === "/admin/dashboard" ? is_active : default_style}
          aria-current={pathname === "/admin/dashboard" ? "page" : undefined}
        >Gestión de la Carta</a>
        <a
          href="/admin/reservation"
          class={pathname === "/admin/reservation" ? is_active : default_style}
          aria-current={pathname === "/admin/reservation" ? "page" : undefined}
        >Reservas</a>
        <a
          href="/admin/hours"
          class={pathname === "/admin/hours" ? is_active : default_style}
          aria-current={pathname === "/admin/hours" ? "page" : undefined}
        >Horarios</a>
        <a
          href="/admin/tables"
          class={pathname === "/admin/tables" ? is_active : default_style}
          aria-current={pathname === "/admin/tables" ? "page" : undefined}
        >Mesas</a>
        <a
          href="/admin/categories"
          class={pathname === "/admin/categories" ? is_active : default_style}
          aria-current={pathname === "/admin/categories" ? "page" : undefined}
        >Categorías</a>
        <a
          href="/admin/allergens"
          class={pathname === "/admin/allergens" ? is_active : default_style}
          aria-current={pathname === "/admin/allergens" ? "page" : undefined}
        >Alérgenos</a>
      </nav>
      <div class="mt-auto flex flex-col gap-2 pt-4 border-t border-muted/20">
        <a
          href="/"
          class="flex flex-row gap-2 py-2 px-2 text-primary hover:text-accent-light hover:scale-110 transition-all duration-300"
          aria-label="Volver al menú principal de la web"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            fill="none"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            class="icon icon-tabler icons-tabler-outline icon-tabler-circle-arrow-left"
            viewBox="0 0 24 24"
            aria-hidden="true"
          ><path fill="none" stroke="none" d="M0 0h24v24H0z"/><path
              d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18m-4-9 4 4m-4-4h8m-4-4-4 4"
            ></path></svg
          >
          Volver a la web
        </a>
        <form method="post" action="/api/logout">
          <button
            type="submit"
            class="flex flex-row gap-2 py-2 px-2 w-full text-primary hover:text-brand-red hover:scale-110 transition-all duration-300 cursor-pointer"
            aria-label="Cerrar sesión"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              fill="none"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              class="icon icon-tabler icons-tabler-outline icon-tabler-logout"
              viewBox="0 0 24 24"
              aria-hidden="true"
            ><path fill="none" stroke="none" d="M0 0h24v24H0z"/><path
                d="M14 8V6a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h7a2 2 0 0 0 2-2v-2"
              /><path d="M9 12h12l-3-3m0 6 3-3"/></svg
            >
            Cerrar sesión
          </button>
        </form>
      </div>
    </aside>

    <main id="admin-main" class="w-full flex-1 flex flex-col overflow-y-auto min-h-screen md:min-h-0" role="main">
      <header class="p-4 sticky top-0 bg-elevated z-10">
        <div class="flex items-center justify-between w-full">
          <button class="md:hidden text-primary shrink-0" data-toggle-sidebar aria-label="Abrir menú lateral">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <line x1="3" y1="6" x2="21" y2="6" />
              <line x1="3" y1="12" x2="21" y2="12" />
              <line x1="3" y1="18" x2="21" y2="18" />
            </svg>
          </button>
          <h1 class="text-accent text-lg sm:text-2xl md:text-4xl font-serif text-center truncate mx-2">
            {pageTitle}
          </h1>
          <div class="shrink-0">
            <slot name="header-right" />
          </div>
        </div>
      </header>
      <slot />
    </main>
  </body>

  <script>
    document.addEventListener("click", (e: MouseEvent) => {
      const target = e.target as Element;
      if (target.closest("[data-toggle-sidebar]")) {
        document.getElementById("sidebar")?.classList.toggle("-translate-x-full");
        document.getElementById("backdrop")?.classList.toggle("hidden");
      }
    });
  </script>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
  }
</style>
