---
import DishCard from "@components/DishCard.astro";
import Layout from "@layouts/Layout.astro";
import Filter from "@components/Filter.astro";
import { getDishesWithAllergens } from "@db/queries";

Astro.response.headers.set(
  "Cache-Control",
  "s-maxage=60, stale-while-revalidate=3600",
);

const dishes = await getDishesWithAllergens();
const categories = [...new Set(dishes.map((d) => d.category_name))];
---

<Layout title="Tu Restaurante - Menu" justify="start">
  <Filter />
  <div class="px-4 py-5">
    <p
      id="no-results"
      class="hidden text-center text-accent-light py-10 text-lg"
    >
      No hay platos que cumplan los filtros seleccionados.
    </p>
    {
      categories.map((cat) => (
        <section class="mt-6 data-hidden:hidden" data-section="category">
          <div class="flex flex-row w-full items-center gap-4 mb-4">
            <h2 class="text-accent font-serif text-2xl whitespace-nowrap transition-opacity duration-300 ease-out data-hidden:opacity-0">
              {cat}
            </h2>
            <div class="flex-1 border-b border-muted/40 transition-opacity duration-300 ease-out data-hidden:opacity-0" />
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            {dishes
              .filter((d) => d.category_name === cat)
              .map((dish) => (
                <DishCard
                  dish={dish}
                  allergens={dish.allergens}
                  category={cat}
                  isEager={dishes.indexOf(dish) < 6}
                />
              ))}
          </div>
        </section>
      ))
    }
  </div>
</Layout>
