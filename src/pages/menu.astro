---
import DishCard from "@components/DishCard.astro";
import Layout from "@layouts/Layout.astro";
import Filter from "@components/Filter.astro";
import dishes from "@data/dishes.json";
import { restaurant } from "@data/restaurant";

type DishAllergen = { id: number; name: string; without_option: number };
type MenuDish = {
  id: number;
  name: string;
  description: string | null;
  price: number;
  image: string | null;
  category_id: number;
  slug: string;
  category_name: string;
  allergens: DishAllergen[];
};

const dishesData = dishes as MenuDish[];

Astro.response.headers.set(
  "Cache-Control",
  "s-maxage=60, stale-while-revalidate=3600",
);

const categories = [...new Set(dishesData.map((d) => d.category_name))];
---

<Layout title="Carta" description={`Descubre nuestra carta: hamburguesas gourmet, carnes maduradas, entrantes y postres caseros en ${restaurant.name}, ${restaurant.address.locality}.`} justify="start">
  <Filter />
  <div class="px-4 py-5">
    <p
      id="no-results"
      class="hidden text-center text-accent-light py-10 text-lg"
    >
      No hay platos que cumplan los filtros seleccionados.
    </p>
    {
      categories.map((cat) => (
        <section class="mt-6 data-hidden:hidden" data-section="category">
          <div class="flex flex-row w-full items-center gap-4 mb-4">
            <h2 class="text-accent font-serif text-2xl whitespace-nowrap transition-opacity duration-300 ease-out data-hidden:opacity-0">
              {cat}
            </h2>
            <div class="flex-1 border-b border-muted/40 transition-opacity duration-300 ease-out data-hidden:opacity-0" />
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            {dishesData
              .filter((d) => d.category_name === cat)
              .map((dish) => (
                <DishCard
                  dish={dish}
                  allergens={dish.allergens}
                  category={cat}
                  isEager={dishesData.indexOf(dish) < 6}
                />
              ))}
          </div>
        </section>
      ))
    }
  </div>
</Layout>
