---
import Layout from "@layouts/Layout.astro";
import map from "@assets/anover-tajo.webp";
import { Image } from "astro:assets";
import { ReservationForm } from "@components/ReservationForm";
import hoursConfig from "@data/hours.json";

type HoursData = Record<string, { closed?: boolean; slots?: string[][] }>;
const hours = hoursConfig as HoursData;

const DAY_NAMES: Record<string, string> = {
  "0": "Domingo",
  "1": "Lunes",
  "2": "Martes",
  "3": "Miércoles",
  "4": "Jueves",
  "5": "Viernes",
  "6": "Sábado",
};

function formatHours(h: HoursData[string]): string {
  if (h?.closed) return "Cerrado";
  if (!h?.slots || h.slots.length === 0) return "Cerrado";
  return h.slots.map((s) => `${s[0].replace(/^0/, "")}-${s[1].replace(/^0/, "")}`).join(" | ");
}
---

<Layout title="Reservas" description="Reserva tu mesa en Tu Restaurante, Tu Ciudad. Elige fecha, hora y número de comensales." justify="center">
  <script set:html={`window.__HOURS_CONFIG = ${JSON.stringify(hoursConfig)};`} />
  <section class="flex flex-col gap-4 justify-center items-center">
    <h1 class="text-4xl text-primary font-serif pt-4">Haz tu Reserva</h1>
    <p class="text-primary/60 text-sm -mt-2">Te enviaremos un email de confirmación con un enlace para cancelar tu reserva si es necesario.</p>
    <div class="flex flex-col md:grid grid-cols-3 gap-6 p-6">
      <ReservationForm client:load />

      <div class="col-span-2 flex flex-col gap-4">
        <div class="relative overflow-hidden group flex-1 max-h-100 min-h-50">
          <Image
            class="w-full h-full object-cover block"
            src={map}
            alt="A stylized dark map of Tu Ciudad with location pins, consistent with the reference image."
          />
          <div class="absolute inset-0 flex flex-col justify-end p-6">
            <div class="flex items-center gap-2 mb-2">
              <a
                href="https://www.google.com/maps/search/?api=1&query=Tu%20Restaurante%2C%20Tu%20Ciudad"
                class="text-accent-light text-sm flex flex-row gap-2 justify-center items-center hover:scale-110 transition-transform duration-300"
                target="_blank"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" class="icon icon-tabler icons-tabler-outline icon-tabler-map-pin text-accent-light" viewBox="0 0 24 24"><path fill="none" stroke="none" d="M0 0h24v24H0z"/><path d="M9 11a3 3 0 1 0 6 0 3 3 0 0 0-6 0"/><path d="M17.657 16.657 13.414 20.9a2 2 0 0 1-2.827 0l-4.244-4.243a8 8 0 1 1 11.314 0"/></svg>
                Nuestra Ubicación
              </a>
            </div>
            <h3 class="text-white font-serif font-bold text-3xl">
              Tu Ciudad
            </h3>
          </div>
        </div>

        <div class="flex flex-col md:flex-row gap-4">
          <div class="bg-card p-4 flex-1">
            <h3 class="text-accent-light flex flex-row gap-2">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                fill="none"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                class="icon icon-tabler icons-tabler-outline icon-tabler-phone"
                viewBox="0 0 24 24"
                ><path fill="none" stroke="none" d="M0 0h24v24H0z"></path><path
                  d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"
                ></path></svg
              >
              Contacto
            </h3>
            <p class="text-wrap text-primary py-4">
              Calle de Tu Restaurante, 1, 00000 Tu Ciudad España
            </p>
            <a
              href="tel:+34600000000"
              class="inline-block text-accent-light hover:scale-110 transition-transform duration-300"
              >+34 600 00 00 00</a
            >
          </div>
          <div class="bg-card p-4 flex-1">
            <h3 class="text-accent-light flex flex-row gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" class="icon icon-tabler icons-tabler-outline icon-tabler-clock" viewBox="0 0 24 24"><path fill="none" stroke="none" d="M0 0h24v24H0z"/><path d="M3 12a9 9 0 1 0 18 0 9 9 0 0 0-18 0"/><path d="M12 7v5l3 3"/></svg>
              Horario
            </h3>
            {
              Object.entries(DAY_NAMES).map(([day, label]) => (
                <div class="flex flex-row justify-between border-b border-b-muted/20 pt-4 pb-2 w-full">
                  <p class="text-primary">{label}</p>
                  <p class="text-primary">{formatHours(hours[day])}</p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
