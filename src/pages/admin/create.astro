---
import LayoutDashboard from "@layouts/LayoutDashboard.astro";
import { DishForm } from "@components/DishForm"
import categoriesData from "@data/categories.json";
import allAllergensData from "@data/allergens.json";
import { verifySession } from "@utils/auth";

if (!verifySession(Astro.cookies.get("admin_session")?.value)) return Astro.redirect("/admin");
---

<LayoutDashboard
  title="Nuevo Plato - Tu Restaurante"
  pageTitle="Nuevo Plato"
>
  <section class="w-full">
    <div class="px-4 py-5 w-full max-w-2xl mx-auto">
      <DishForm
        client:load
        categories={categoriesData}
        allAllergens={allAllergensData}
      />
    </div>
  </section>
</LayoutDashboard>
