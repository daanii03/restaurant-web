---
import LayoutDashboard from "@layouts/LayoutDashboard.astro";
import { DishForm } from "@components/DishForm"
import { getCategories, getAllergens } from "@db/queries";

if (!Astro.cookies.has("admin_session")) return Astro.redirect("/admin");

const [categories, allAllergens] = await Promise.all([
  getCategories(),
  getAllergens(),
]);
---

<LayoutDashboard
  title="Nuevo Plato - Tu Restaurante"
  pageTitle="Nuevo Plato"
>
  <section class="w-full">
    <div class="px-4 py-5 w-full max-w-2xl mx-auto">
      <DishForm
        client:load
        categories={categories}
        allAllergens={allAllergens}
      />
    </div>
  </section>
</LayoutDashboard>
