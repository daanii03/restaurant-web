---
import dishes from "@data/dishes.json";
import categoriesData from "@data/categories.json";
import allAllergensData from "@data/allergens.json";
import LayoutDashboard from "@layouts/LayoutDashboard.astro";
import { DishForm } from "@components/DishForm"

type DishAllergen = { id: number; name: string; without_option: number };
type JsonDish = {
  id: number;
  name: string;
  description: string | null;
  price: number;
  image: string | null;
  category_id: number;
  slug: string;
  category_name: string;
  allergens: DishAllergen[];
};

const { id } = Astro.params;

if (!id || isNaN(Number(id))) {
  return Astro.redirect("/admin/dashboard");
}

const dishId = Number(id);

const dishesData = dishes as JsonDish[];
const jsonDish = dishesData.find((d) => d.id === dishId) ?? null;

const dish = jsonDish
  ? {
      id: jsonDish.id,
      name: jsonDish.name,
      price: jsonDish.price,
      description: jsonDish.description ?? "",
      image: jsonDish.image ?? "",
      category_id: jsonDish.category_id,
      allergens: jsonDish.allergens.map((a) => a.id),
      allergens_without: jsonDish.allergens
        .filter((a) => a.without_option === 1)
        .map((a) => a.id),
    }
  : null;
---

<LayoutDashboard
  title={`Editar ${dish ? dish.name : "Plato"} - Tu Restaurante`}
  pageTitle={`Editar: ${dish ? dish.name : "Plato"}`}
>
  <section class="w-full">
    <div class="px-4 py-5 w-full max-w-2xl mx-auto">
      {
        dish ? (
          <DishForm
            client:load
            dish={dish}
            categories={categoriesData}
            allAllergens={allAllergensData}
          />
        ) : (
          <p class="text-primary font-bold text-center py-10">
            Plato no encontrado
          </p>
        )
      }
    </div>
  </section>
</LayoutDashboard>
