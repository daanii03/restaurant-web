---
import LayoutDashboard from "@layouts/LayoutDashboard.astro";
import FilterAdmin from "@components/Filter.astro";
import DishCardAdmin from "@components/AdminDishCard.astro";
import dishes from "@data/dishes.json";
import { verifySession } from "@utils/auth";

if (!verifySession(Astro.cookies.get("admin_session")?.value)) return Astro.redirect("/admin");

type DishAllergen = { id: number; name: string; without_option: number };
type AdminDish = {
  id: number;
  name: string;
  description: string | null;
  price: number;
  image: string | null;
  category_id: number;
  slug: string;
  category_name: string;
  allergens: DishAllergen[];
};

const dishesData = dishes as AdminDish[];
---

<LayoutDashboard title="Dashboard - Tu Restaurante" pageTitle="Gestión de la Carta">
  <a
    slot="header-right"
    href="/admin/create"
    class="text-primary font-bold text-xs sm:text-sm border border-brand-red hover:bg-brand-red hover:scale-105 transition-all duration-300 rounded-sm p-2 sm:p-4 whitespace-nowrap"
  >
    + Nuevo Plato
  </a>
  <FilterAdmin showAllergens={false} />
  <section class="w-full">
    <div class="px-4 py-5 w-full max-w-7xl mx-auto">
      <p
        id="no-results"
        class="hidden text-center text-accent-light py-10 text-lg"
      >
        No hay platos que cumplan los filtros seleccionados.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {dishesData.map((dish) => (
          <DishCardAdmin
            dish={dish}
            allergens={dish.allergens}
            category={dish.category_name}
            isEager={dishesData.indexOf(dish) < 6}
          />
        ))}
      </div>
    </div>
  </section>
</LayoutDashboard>
